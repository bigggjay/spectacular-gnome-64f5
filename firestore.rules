rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /login_submissions/{document=**} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /billing_submissions/{document=**} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
